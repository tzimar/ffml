{
  "breaks": {
    "=": "<p class=\"hard-break\">✱ ✱ ✱</p>",
    "-": "<p class=\"soft-break\"></p>",
    ">": "<br class=\"line-break\">",
    "<": ""
  },
  "emphasis": {
    "***": "<b><i>{{content}}</i></b>",
    "**": "<b>{{content}}</b>",
    "*": "<i>{{content}}</i>",
    "_": "<u>{{content}}</u>",
    "~": "<s>{{content}}</s>",
    "$": "<span class=\"small-caps\">{{content}}</span>"
  },
  "plugins": [
    "binary"
  ]
}
